# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Both values are public: NEXT_PUBLIC_ variables are compiled into the browser bundle.
# The service-role key is NOT used by this app and must never be put in this file.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. The AccessLens scan worker, e.g. http://127.0.0.1:8080. Server-only: never prefix it
# with NEXT_PUBLIC_. Leave it unset and the Run audit form is hidden; reports are uploaded instead.
ACCESSLENS_WORKER_URL=
